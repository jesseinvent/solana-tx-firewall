# Copy to .env.local. Everything is optional.

# RPC used for simulation, lookup tables and history. The public endpoint works but
# rate-limits; use Helius / Triton / QuickNode for real use.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Plain-English summaries by Claude. Without a key, the rule engine writes the summary.
# Claude only explains: the verdict always comes from the deterministic rules.
ANTHROPIC_API_KEY=
